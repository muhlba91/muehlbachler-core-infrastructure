---
services:
  client:
    image: netbirdio/netbird:0.80.0
    container_name: netbird-client
    restart: unless-stopped
    environment:
      - NB_MANAGEMENT_URL=https://{{ .domain }}
      - NB_HOSTNAME={{ .hostname }}
      - NB_INTERFACE_NAME=wt0
      - NB_WIREGUARD_PORT={{ .wireguardPort }}
      - NB_MTU={{ .mtu }}
      # routing between the sites is done by EVPN/BGP, not by NetBird: no DNS takeover, no route install
      - NB_DISABLE_DNS=true
      - NB_DISABLE_CLIENT_ROUTES=true
      # this server is the routing peer of the NetBird clients into the sites (network 'sites', masqueraded)
      - NB_DISABLE_SERVER_ROUTES=false
      # the NetBird access policies are enforced on traffic arriving through the overlay (own nftables tables)
      # NB_DISABLE_* settings are stored at the registration: a registered client only takes changes with 'netbird down' and 'netbird up'
      - NB_DISABLE_FIREWALL=false
      - NB_LOG_LEVEL=info
      # the setup key is only needed for the first registration: it is removed from the server once the client is connected
      - NB_SETUP_KEY={{ .setupKey }}
    network_mode: host
    cap_add:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - /opt/netbird-client/state:/var/lib/netbird
