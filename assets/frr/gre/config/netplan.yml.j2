---
network:
  version: 2
  tunnels:
    {{ .Name }}:
      mode: {{ .Type }}
      local: {{ .LocalIP }}
      remote: {{ .RemoteIP }}
      addresses:
        - "{{ .TunnelIP }}"
        - "{{ .LinkLocalIP }}"
      mtu: {{ .MTU }}
{{- if .Key }}
      key: {{ .Key }}
{{- end }}
      accept-ra: false
      ipv6-privacy: false
